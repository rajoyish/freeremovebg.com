---
// Shared markup for the About page, dictionary-driven so the English route
// (/about) and the localized route (/[lang]/about) render from one source.
// Copy lives in en.json → pages.about.
import Layout from '../../layouts/Layout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Breadcrumb from '../Breadcrumb.astro';
import { getDictionary, PAGE_LANGS, revise } from '../../i18n/dictionaries';
import { DEFAULT_LANG } from '../../i18n/config';
import { homeHref, pageHref } from '../../i18n/routes';
import en from '../../i18n/en.json';
import pkg from '../../../package.json';

interface Props {
  lang?: string;
}

const { lang = DEFAULT_LANG } = Astro.props;
const dict = getDictionary(lang);
// Converter and optimizer copy (revisions.about), where this language has it.
// Vector conversion copy (revisions.aboutVector) on top, where translated.
const t = revise(lang, revise(lang, dict.pages.about, 'about'), 'aboutVector');

// The vector converter runs AGPL software (Ghostscript, MuPDF) in the
// visitor's browser, so this page names each open-source component with its
// exact version and licence and links to its source. Names, versions,
// licence IDs and URLs read the same in every language, so none of this goes
// through translation.
const deps = pkg.dependencies as Record<string, string>;
const version = (name: string) => deps[name]?.replace(/^[\^~]/, '') ?? '';
const openSource = [
  { name: 'Ghostscript', detail: `@jspawn/ghostscript-wasm ${version('@jspawn/ghostscript-wasm')}`, license: 'AGPL-3.0',
    source: 'https://github.com/jsscheller/ghostscript-wasm', upstream: 'https://git.ghostscript.com/?p=ghostpdl.git' },
  { name: 'MuPDF', detail: `mupdf ${version('mupdf')}`, license: 'AGPL-3.0-or-later',
    source: 'https://github.com/ArtifexSoftware/mupdf.js', upstream: 'https://git.ghostscript.com/?p=mupdf.git' },
  { name: 'pdf.js', detail: `pdfjs-dist ${version('pdfjs-dist')}`, license: 'Apache-2.0',
    source: 'https://github.com/mozilla/pdf.js' },
  { name: 'svg2pdf.js', detail: `svg2pdf.js ${version('svg2pdf.js')}`, license: 'MIT',
    source: 'https://github.com/yWorks/svg2pdf.js' },
  { name: 'jsPDF', detail: `jspdf ${version('jspdf')}`, license: 'MIT',
    source: 'https://github.com/parallax/jsPDF' },
];
// The open-source section, found by its position in the English revision:
// a translated revision keeps the same order. A language still on the older
// copy has no such section and shows no list.
const openSourceIndex = t.sections.length === en.revisions.aboutVector.sections.length
  ? en.revisions.aboutVector.sections.findIndex((s) => s.heading === 'Built on Open Source')
  : -1;
const linkClass = 'text-link underline underline-offset-2 hover:text-link-deep';
---

<Layout
  title={t.title}
  description={t.description}
  keywords={dict.meta.keywords}
  lang={lang}
  basePath="/about"
  hreflangLangs={PAGE_LANGS}
  pageType="AboutPage"
  app={null}
>
  <div class="min-h-screen flex flex-col">
    <Header lang={lang} basePath="/about" availableLangs={PAGE_LANGS} />
    <Breadcrumb path={pageHref(lang, '/about')} current={dict.nav.about} lang={lang} />

    <main class="flex-1">

      <section class="px-6 pt-16 pb-8 text-center">
        <div class="max-w-[760px] mx-auto">
          <h1 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold tracking-[-2px] leading-[1.1] mt-0 mb-5 text-ink">
            {t.h1}
          </h1>
          <p class="text-lg text-body leading-[1.7] mt-0 mb-0 max-w-[600px] mx-auto">
            {t.intro}
          </p>
        </div>
      </section>

      <section class="px-6 py-16">
        <article class="max-w-[760px] mx-auto">
          {t.sections.map((section, i) => (
            <div class:list={['reveal', i > 0 && 'mt-12']} data-reveal>
              <h2 class="text-[clamp(1.5rem,4vw,2rem)] font-semibold tracking-[-1px] leading-tight text-ink mt-0 mb-5">{section.heading}</h2>
              <p class="text-base text-body leading-[1.8] m-0">{section.body}</p>
              {i === openSourceIndex && (
                <ul class="list-none m-0 mt-6 p-0 rounded-md border border-hairline divide-y divide-hairline text-sm" dir="ltr">
                  {openSource.map((c) => (
                    <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-3">
                      <a href={c.source} class={`font-semibold ${linkClass}`} rel="noopener">{c.name}</a>
                      <span class="font-mono text-xs text-mute">{c.detail}</span>
                      {c.license && <span class="font-mono text-[11px] px-1.5 py-px rounded-xs border border-hairline text-body">{c.license}</span>}
                      {c.upstream && <a href={c.upstream} class={`ms-auto font-mono text-xs ${linkClass}`} rel="noopener">{new URL(c.upstream).host}</a>}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}

          <div class="reveal mt-14 text-center" data-reveal>
            <a href={homeHref(lang)}
              class="inline-flex items-center gap-2 px-6 py-3 bg-ink text-on-primary rounded-pill text-sm font-medium no-underline transition-opacity hover:opacity-[0.85]">
              {t.cta}
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </article>
      </section>

    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<script>
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach(el => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
    revealEls.forEach(el => observer.observe(el));
  }
</script>
