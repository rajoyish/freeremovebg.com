---
import { SITE, DEFAULT_LANG } from '../i18n/config';
import { getDictionary } from '../i18n/dictionaries';

interface Props {
  current: string;
  lang?: string;
  /** Path of the page itself, for the trail's second `item`. */
  path?: string;
}

const { current, lang = DEFAULT_LANG, path } = Astro.props;

const dict = getDictionary(lang);
const homeLabel = dict.nav.home;
const homeHref = lang === DEFAULT_LANG ? '/' : `/${lang}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: `${SITE}${homeHref}` },
    // Naming the URL as well as the label lets Google render the localized
    // trail under the result instead of falling back to the bare domain.
    {
      '@type': 'ListItem',
      position: 2,
      name: current,
      ...(path ? { item: `${SITE}${path}` } : {}),
    },
  ],
};
---

<nav aria-label="Breadcrumb" class="px-6 pt-6 pb-0">
  <ol class="max-w-190 mx-auto flex items-center gap-2 text-sm text-mute m-0 p-0 list-none">
    <li>
      <a href={homeHref} class="text-mute no-underline hover:text-ink transition-colors">{homeLabel}</a>
    </li>
    <li aria-hidden="true" class="select-none">/</li>
    <li>
      <span class="text-ink font-medium">{current}</span>
    </li>
  </ol>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</nav>
