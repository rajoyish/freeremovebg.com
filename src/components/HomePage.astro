---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Tool from './Tool.astro';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_LANG } from '../i18n/config';

interface Props {
  lang?: string;
}

const { lang = DEFAULT_LANG } = Astro.props;
const dict = getDictionary(lang);
const t = dict.tool;
const faqs = dict.faq.items;

const featureIcons = [
  '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
  '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>',
  '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12.18a1 1 0 0 0 .6.91l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 .6-.92"/><path d="M2 16.18a1 1 0 0 0 .6.91l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 .6-.92"/>',
  '<path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z"/>',
  '<path d="m2 2 20 20"/><path d="M5.782 5.782A7 7 0 0 0 9 19h8.5a4.5 4.5 0 0 0 1.307-.193"/><path d="M21.532 16.5A4.5 4.5 0 0 0 17.5 10h-1.79A7.008 7.008 0 0 0 10 5.07"/>',
  '<circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/>',
  '<path d="M18 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8"/><path d="M7 19h5"/><path d="M10 15v4"/><rect width="6" height="10" x="16" y="12" rx="2"/>',
];

const faqText = (html: string) =>
  html
    .replace(/<[^>]+>/g, '')
    .replace(/&rarr;/g, '→')
    .replace(/&amp;/g, '&')
    .replace(/\s+/g, ' ')
    .trim();
---

<Layout title={dict.meta.title} description={dict.meta.description} keywords={dict.meta.keywords} lang={lang} basePath="/">
  <div class="min-h-screen flex flex-col">
    <Header lang={lang} basePath="/" />

    <main class="flex-1">

      <section class="px-6 pt-16 pb-8 text-center">
        <div class="max-w-7xl mx-auto">
          <h1 class="text-[clamp(2rem,5vw,3.5rem)] font-semibold tracking-[-2px] leading-[1.1] mt-0 mb-5 text-ink">
            {dict.hero.titleLead} <br> {dict.hero.titleAccent}
          </h1>
          <p class="text-lg text-body leading-[1.7] mt-0 mb-8 max-w-175 mx-auto">
            {dict.hero.subtitle}
          </p>
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-canvas-soft-2 border border-hairline rounded-pill text-[13px] text-body font-medium">
            <svg width="14" height="14" fill="none" class="stroke-link" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {dict.hero.privacyBadge}
          </div>
          <div id="global-counter-wrapper" class="mt-8 mb-0 flex flex-col items-center gap-1">
            <span id="global-counter" class="text-[clamp(1.75rem,4vw,2.5rem)] font-semibold tracking-[-1px] leading-none text-ink tabular-nums">0</span>
            <span class="text-sm font-medium uppercase tracking-wide text-mute">{t.globalCounterLabel}</span>
          </div>
        </div>
      </section>

      <Tool lang={lang} />

      <section class="px-6 py-16 bg-canvas-soft-2 border-t border-hairline">
        <div class="max-w-250 mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-[clamp(1.5rem,4vw,2.25rem)] font-semibold tracking-[-1px] text-ink mt-0 mb-3">{dict.features.heading}</h2>
            <p class="text-base text-body leading-relaxed max-w-150 mx-auto m-0">{dict.features.subheading}</p>
          </div>
          <div class="grid gap-x-10 gap-y-12 grid-cols-[repeat(auto-fit,minmax(240px,1fr))]">
            {dict.features.items.map((item, i) => (
              <div class="text-center">
                <div class="w-11 h-11 bg-ink rounded-[10px] flex items-center justify-center mx-auto mb-3.5">
                  <svg width="22" height="22" fill="none" class="stroke-on-primary" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={featureIcons[i % featureIcons.length]} />
                </div>
                <h3 class="text-base font-semibold text-ink mt-0 mb-2">{item.title}</h3>
                <p class="text-sm text-body leading-relaxed m-0">{item.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="px-6 py-20 border-t border-hairline">
        <article id="seo-article" class="max-w-190 mx-auto">
          {dict.article.blocks.map((block, i) => (
            <div class:list={['reveal', i > 0 && 'mt-12']} data-reveal>
              {i === 0 ? (
                <h2 class="text-[clamp(1.6rem,4vw,2.4rem)] font-semibold tracking-[-1px] leading-tight text-ink mt-0 mb-5">{block.heading}</h2>
              ) : (
                <h3 class="text-[1.3rem] font-semibold text-ink mt-0 mb-4">{block.heading}</h3>
              )}
              <p class="text-base text-body leading-[1.8] m-0">{block.body}</p>
            </div>
          ))}
        </article>
      </section>

      <section class="px-6 py-20 bg-canvas-soft-2 border-t border-hairline">
        <div class="max-w-190 mx-auto">
          <div class="reveal text-center mb-10" data-reveal>
            <h2 class="text-[clamp(1.6rem,4vw,2.4rem)] font-semibold tracking-[-1px] leading-tight text-ink mt-0 mb-3">{dict.faq.heading}</h2>
            <p class="text-base text-body leading-relaxed m-0 max-w-140 mx-auto">{dict.faq.subheading}</p>
          </div>

          <div class="reveal flex flex-col gap-3" data-reveal>
            {faqs.map((faq) => (
              <details class="group bg-canvas border border-hairline rounded-lg overflow-hidden">
                <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none text-[15px] font-medium text-ink select-none">
                  <span>{faq.q}</span>
                  <svg class="shrink-0 w-4 h-4 text-mute transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
                  </svg>
                </summary>
                <div class="px-5 pb-4 pt-0 text-[14px] text-body leading-[1.7] [&_p]:m-0 [&_p+p]:mt-3" set:html={faq.a}></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.q,
          acceptedAnswer: { '@type': 'Answer', text: faqText(faq.a) },
        })),
      })} />

    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<script>
  const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach(el => el.classList.add('is-visible'));
  } else {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });

    revealEls.forEach(el => revealObserver.observe(el));
    window.addEventListener('pagehide', () => revealObserver.disconnect(), { once: true });
  }
</script>

<script>
  // Global cutout counter — always-on, animated, "live"-feeling worldwide total.
  //
  // Cost model: the only network call is GET /api/count (edge-cached 60s), made
  // on load and once per ~60s reconcile. The continuous upward motion is a purely
  // client-side simulation — it never touches D1, so it stays inside the free tier.
  const counterEl = document.getElementById('global-counter');

  if (counterEl) {
    const locale = document.documentElement.lang || 'en';
    const compact = new Intl.NumberFormat(locale, {
      notation: 'compact',
      maximumFractionDigits: 1,
    });
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // `displayValue` is the source of truth for what's on screen. It only ever
    // moves upward, so reconciling with the real total never snaps it backwards.
    let displayValue = 0;
    let rafId = 0;

    const render = (n: number) => {
      counterEl.textContent = compact.format(Math.floor(n));
    };

    // Ease-out tween from the current display value up to `target`.
    function animateTo(target: number): void {
      if (target <= displayValue) {
        displayValue = target;
        render(displayValue);
        return;
      }
      if (reduceMotion) {
        displayValue = target;
        render(displayValue);
        return;
      }
      cancelAnimationFrame(rafId);
      const from = displayValue;
      const delta = target - from;
      const duration = Math.min(2000, 600 + delta * 4); // longer climb for bigger jumps
      let start = 0;
      const step = (ts: number) => {
        if (!start) start = ts;
        const p = Math.min(1, (ts - start) / duration);
        const eased = 1 - Math.pow(1 - p, 3); // ease-out cubic
        displayValue = from + delta * eased;
        render(displayValue);
        if (p < 1) rafId = requestAnimationFrame(step);
        else displayValue = target;
      };
      rafId = requestAnimationFrame(step);
    }

    // `fresh` bypasses the 60s cache so a refresh right after the visitor's own
    // cutouts reflects the new total instead of a stale cached value.
    async function fetchGlobalCount(fresh = false): Promise<void> {
      try {
        const url = fresh ? `/api/count?t=${Date.now()}` : '/api/count';
        const res = await fetch(url, {
          headers: { Accept: 'application/json' },
          cache: fresh ? 'no-store' : 'default',
        });
        if (!res.ok) return;
        const data = await res.json();
        const count = Number(data?.count ?? 0);
        if (Number.isFinite(count)) animateTo(count); // only ever climbs upward
      } catch {
        // Counter is non-critical — keep showing the last value on failure.
      }
    }

    // Gentle simulated "live" ticks: nudge the number up by a tiny random amount
    // every few seconds so it feels alive between the 60s real reconciles.
    function scheduleTick(): void {
      const delay = 3000 + Math.random() * 3000; // 3–6s
      window.setTimeout(() => {
        const bump = 1 + Math.floor(Math.random() * 3); // +1..3
        animateTo(Math.floor(displayValue) + bump);
        scheduleTick();
      }, delay);
    }

    fetchGlobalCount();
    scheduleTick();
    window.setInterval(() => fetchGlobalCount(), 60000); // reconcile with real total
    window.addEventListener('global-counter-updated', () => fetchGlobalCount(true));
  }
</script>
