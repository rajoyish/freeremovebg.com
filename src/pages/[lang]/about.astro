---
import AboutPage from '../../components/pages/AboutPage.astro';
import { PAGE_LANGS } from '../../i18n/dictionaries';
import { DEFAULT_LANG } from '../../i18n/config';

// Only languages whose locale file carries every `pages` string, so an
// untranslated language never gets English prose under a /<lang>/ URL.
export function getStaticPaths() {
  return PAGE_LANGS.filter((lang) => lang !== DEFAULT_LANG).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
---

<AboutPage lang={lang} />
